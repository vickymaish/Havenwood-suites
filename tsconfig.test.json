{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".test-out",
    "noEmit": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["tests/**/*.test.ts"],
  "exclude": ["node_modules", ".next", ".test-out"]
}
