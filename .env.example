NEXT_PUBLIC_WEB3FORMS_KEY=your_key_here
MPESA_TILL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# New Supabase projects may provide a publishable key instead of an anon key.
# Set this only if NEXT_PUBLIC_SUPABASE_ANON_KEY is not available.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional, for the authenticated admin integration check only. Supply both values in the process environment.
# TEST_ADMIN_EMAIL=owner@example.com
# TEST_ADMIN_PASSWORD=replace-with-a-temporary-test-password
